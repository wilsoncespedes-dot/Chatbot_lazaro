# Copia este archivo como .env y rellena los valores. NUNCA subas .env a git.
# Los agentes tienen prohibido leer .env; solo pueden leer este .env.example.

# Entorno: development | production (en producción se validan los secretos)
APP_ENV=development
# URL pública del servicio telegram_gateway para registrar el webhook
PUBLIC_BASE_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Timeout (segundos) para confirmar los callbacks de botones (answerCallbackQuery)
TELEGRAM_ANSWER_CALLBACK_TIMEOUT_SECONDS=3

# Token compartido entre servicios (encabezado X-Service-Token).
# OBLIGATORIO: ningún servicio arranca si está vacío o vale "cambia-esto".
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_TOKEN=cambia-esto

# Infraestructura
DATABASE_URL=postgresql://lazaro:lazaro@postgres:5432/lazaro
REDIS_URL=redis://redis:6379/0
# timeout (segundos, > 0 y <= 10) de las comprobaciones de GET /health
HEALTHCHECK_TIMEOUT_SECONDS=2

# Postgres (contenedor). POSTGRES_PASSWORD es obligatorio: docker compose ya no
# trae valor por defecto. Usa una clave larga distinta en producción.
POSTGRES_USER=lazaro
POSTGRES_PASSWORD=lazaro
POSTGRES_DB=lazaro

# Proveedor de IA (modelos baratos en pruebas)
LLM_API_KEY=
LLM_MODEL=
EMBEDDINGS_MODEL=

# URLs internas
ORCHESTRATOR_URL=http://orchestrator:8000
# URL interna del gateway; la usa gmail_sync_worker (sincronizar_gmail.py cada 60 s)
TELEGRAM_GATEWAY_URL=http://telegram_gateway:8000
RAG_URL=http://rag:8000
HANDOVER_URL=http://handover:8000

# Supuestos a confirmar (ver docs/proyecto.md §12)
RAG_SIMILARITY_THRESHOLD=0.75
RAG_TOP_K=5
# Preguntas de seguimiento: si el mensaje tiene como máximo RAG_FOLLOWUP_MAX_WORDS
# palabras y hubo otra pregunta en los últimos RAG_FOLLOWUP_WINDOW_MINUTES, se busca
# también con esa pregunta anterior y se combinan los resultados.
RAG_FOLLOWUP_ENABLED=true
RAG_FOLLOWUP_MAX_WORDS=8
RAG_FOLLOWUP_WINDOW_MINUTES=30
HANDOVER_TIMEOUT_SECONDS=300

# orchestrator
LLM_BASE_URL=https://api.openai.com/v1
# Encabezado de sesión que exige el proveedor (OpenCode Go: x-opencode-session); vacío = no se envía
LLM_SESSION_HEADER=
# Tiempo máximo de espera de la IA en segundos (los modelos que razonan tardan más)
LLM_TIMEOUT_SECONDS=60

# servidor MCP de solo lectura (#74)
# false: el bot responde como hoy y no contacta al servidor MCP.
# true: el router puede usar consultar_herramientas_mcp (ofertas DEMO y manuales).
MCP_ENABLED=false
MCP_URL=http://mcp_lectura:8000/mcp
MCP_TIMEOUT_SECONDS=10
# máximo de llamadas a herramientas MCP por mensaje (1-6)
MCP_MAX_TOOL_STEPS=3
MCP_DEMO_NOTICE=Ejemplo de DEMOSTRACIÓN: no son ofertas reales de Lázaro Software.
# mcp_lectura: true inserta 3 ofertas ficticias en demo_ofertas (nunca datos reales)
MCP_DEMO_SEED=false
# DSN del servidor MCP; vacío = usa DATABASE_URL
MCP_DATABASE_URL=
# máximo de filas por herramienta (1-100)
MCP_MAX_ROWS=20
# Modelo local con Ollama (perfil opcional):
#   docker compose --profile ollama up -d ollama
#   docker compose exec ollama ollama pull <modelo>
# Luego ajusta:
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=<modelo>
NO_ANSWER_REPLY=No tengo ese dato en los manuales disponibles. Puedo pasarte con un asesor si lo necesitas.
HANDOVER_ACK_REPLY=Avisé a un asesor; te responderá por aquí en cuanto pueda.
ERROR_REPLY=Tuve un problema para responderte. Inténtalo de nuevo en unos minutos.
INVALID_ANSWER_HANDOVER=true
# traspaso automático (#32): fallos consecutivos antes de derivar y motivos que cuentan
# AUTO_HANDOVER_FAILURE_REASONS solo admite no_relevant_chunks e invalid_answer
AUTO_HANDOVER_FAILURE_THRESHOLD=3
AUTO_HANDOVER_FAILURE_REASONS=no_relevant_chunks,invalid_answer
HANDOVER_KEYWORDS=hablar con una persona,hablar con un asesor,hablar con un humano,quiero un asesor,quiero un agente,agente humano
NO_ADVISORS_REPLY=En este momento no hay asesores disponibles. Tu consulta quedó registrada y te escribiremos en cuanto haya alguien.
CASE_CLOSED_REPLY=Tu caso con el asesor quedó cerrado. Si necesitas algo más, escríbenos por aquí.
FORWARD_FAILED_REPLY=No pude hacer llegar tu mensaje al asesor. Inténtalo de nuevo en unos minutos.
# verificación de cuentas (#20)
LINK_TOKEN_TTL_MINUTES=15
PASSWORD_HASH_ITERATIONS=600000
PROFILE_PASSWORD_MIN_LENGTH=12
TELEGRAM_BOT_USERNAME=
LINK_SUCCESS_REPLY=Tu cuenta de Telegram quedó vinculada a tu perfil.
LINK_FAILED_REPLY=No se pudo vincular la cuenta. Pide un enlace nuevo a tu administrador.
# panel administrativo (#21)
ADMIN_SESSION_TTL_MINUTES=60
ADMIN_COOKIE_SECURE=true
ADMIN_EVENTS_LIMIT=100
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_TRUST_PROXY_HEADERS=false
# límite de tamaño de la carga de manuales desde el panel (#22)
ADMIN_MANUAL_MAX_BYTES=20971520
# importación de clientes desde CSV (#77): tamaño, filas y vigencia de la vista previa
CLIENT_IMPORT_MAX_BYTES=1048576
CLIENT_IMPORT_MAX_ROWS=1000
CLIENT_IMPORT_PREVIEW_TTL_SECONDS=900
# clasificador de consultas (#25): umbral por defecto entre 0 y 1
CLASSIFIER_DEFAULT_THRESHOLD=0.6
# roles de solo lectura (fase 4, migración 0004): sin clave quedan sin LOGIN.
# El servicio migrate les da LOGIN con estas claves (16-128 caracteres, sin
# comillas ni espacios). bot_consultas → DB_QUERY; bot_lectura → CLIENT_DATA.
BOT_CONSULTAS_PASSWORD=
BOT_LECTURA_PASSWORD=
# consultas de datos en lenguaje natural (#26)
# Supuesto S1: al activar DB_QUERY_ENABLED se envían al proveedor de IA SOLO los
# nombres estáticos de las vistas y columnas de DB_QUERY_ALLOWLIST; nunca filas.
# Para activarlo: BOT_CONSULTAS_PASSWORD con valor, el DSN con el rol bot_consultas
# y DB_QUERY_ENABLED=true. Con el usuario de DATABASE_URL el orquestador no arranca.
DB_QUERY_ENABLED=false
# postgresql://bot_consultas:<BOT_CONSULTAS_PASSWORD>@postgres:5432/lazaro
DB_QUERY_DATABASE_URL=
DB_QUERY_VIEWS_SCHEMA=consultas
# vistas agregadas de la migración 0004 (sin datos personales); deben coincidir exactas
DB_QUERY_ALLOWLIST={"consultas.v_casos": ["caso", "estado", "motivo", "canal", "creado", "asignado", "cerrado"], "consultas.v_mensajes_diarios": ["dia", "canal", "rol", "mensajes"], "consultas.v_ofertas": ["id", "destino", "titulo", "precio_cop", "valido_desde", "valido_hasta", "etiqueta"]}
DB_QUERY_MAX_ROWS=50
DB_QUERY_TIMEOUT_MS=5000
DB_QUERY_MAX_JOINS=1
DB_QUERY_MAX_QUESTION_LENGTH=500
DB_QUERY_MAX_REPLY_CHARS=3500
DB_QUERY_HELP_REPLY=Uso: /consultar <pregunta>. Ejemplo: /consultar cuántos pedidos hay pendientes.
DB_QUERY_FORBIDDEN_REPLY=No tienes permiso para consultar datos. Esta función es solo para asesores verificados.
DB_QUERY_DISABLED_REPLY=Las consultas de datos están deshabilitadas en este momento.
DB_QUERY_REJECTED_REPLY=No pude construir una consulta segura para esa pregunta. Reformúlala o consulta una vista permitida.
DB_QUERY_UNAVAILABLE_REPLY=No se pudo completar la consulta de datos. Inténtalo de nuevo más tarde.
DB_QUERY_TRUNCATED_NOTE=Mostrando solo las primeras filas; hay más resultados.

# harness de IA por estado (#39)
HARNESS_ROUTER_ENABLED=false
HARNESS_MAX_INPUT_CHARS=2000
HARNESS_INJECTION_PATTERNS=ignora tus instrucciones,ignora tus reglas,ignora las instrucciones,olvida tus reglas,ignore previous instructions,system prompt,prompt de sistema,actua como administrador,modo desarrollador,jailbreak
HARNESS_FRUSTRATION_ESCALATION=true
HARNESS_FRUSTRATION_KEYWORDS=no me sirves,no me estas ayudando,esto no sirve,estoy harto,estoy harta,pesimo servicio,que mal servicio
HARNESS_SUPPRESSION_KEYWORDS=borrar mis datos,borren mis datos,suprimir mis datos,eliminar mis datos,eliminen mis datos
HARNESS_INPUT_TOO_LONG_REPLY=Tu mensaje es muy largo. Escríbelo en un mensaje más corto, por favor.
# modo conversacional sin hechos de negocio sin fuente (#88)
CONVERSATIONAL_MODE_ENABLED=true
CONVERSATIONAL_BUSINESS_TERMS=Lázaro,producto,productos,servicio,servicios,precio,precios,plan,planes,tarifa,tarifas,factura,facturas,pago,pagos,cuenta,cuentas,cliente,clientes,usuario,usuarios,política,políticas,proceso,procesos,operación,operaciones,licencia,licencias,contrato,contratos,pedido,pedidos,reserva,reservas,soporte,horario,horarios,garantía,garantías,manual,manuales,instalar,instalo,instala,instale,instalación,configurar,configura,configuración
# respuesta social determinista (#59): sin RAG, sin LLM, sin coste
SOCIAL_MESSAGES=hola,buenas,buenos días,buenas tardes,buenas noches,buen día,que tal,hey,hola a todos,gracias,muchas gracias,gracias por todo,ok,okey,vale,perfecto,genial,entendido,de acuerdo,listo,cómo estás,cómo va,hasta luego,adiós,nos vemos
SOCIAL_REPLY=¡Hola! Gracias por escribirnos. ¿En qué puedo ayudarte?
HARNESS_TOOL_DENIED_REPLY=No puedo hacer eso en este momento. Si necesitas ayuda, puedo pasarte con un asesor.
SUPPRESSION_REQUEST_REPLY=Registramos tu solicitud de supresión de datos con el número {request_id}. Una persona autorizada la atenderá y te informará el resultado.
# datos propios del cliente (#39): vistas con RLS y rol separado, ver docs/consulta_bd.md
# Para activarlo: BOT_LECTURA_PASSWORD con valor, el DSN con el rol bot_lectura y
# CLIENT_DATA_ENABLED=true. Cada vista filtra por lazaro.cliente_id (RLS forzada).
CLIENT_DATA_ENABLED=false
# postgresql://bot_lectura:<BOT_LECTURA_PASSWORD>@postgres:5432/lazaro
CLIENT_DATA_DATABASE_URL=
CLIENT_DATA_VIEWS_SCHEMA=mis_datos
CLIENT_DATA_ALLOWLIST={"mis_datos.v_mi_cuenta": ["id_cliente", "usuario", "correo", "telefono", "acceso_desde", "acceso_hasta"], "mis_datos.v_mis_casos": ["caso", "estado", "motivo", "creado", "cerrado"], "mis_datos.v_mis_sesiones": ["canal", "inicio", "fin"]}
CLIENT_DATA_RLS_SETTING=lazaro.cliente_id
CLIENT_DATA_MAX_ROWS=20
CLIENT_DATA_TIMEOUT_MS=5000
CLIENT_DATA_MAX_JOINS=1
CLIENT_DATA_MAX_REPLY_CHARS=3500
CLIENT_DATA_TRUNCATED_NOTE=Mostrando solo las primeras filas; hay más resultados.
CLIENT_DATA_DISABLED_REPLY=La consulta de tus datos no está disponible por ahora.
CLIENT_DATA_REJECTED_REPLY=No pude construir una consulta segura para esa pregunta. Intenta formularla de otra forma.
CLIENT_DATA_UNAVAILABLE_REPLY=No se pudo consultar tus datos. Inténtalo de nuevo más tarde.

# gráficos del bot (fase 5): herramienta `graficar` sobre los datos propios del cliente.
# PNG dibujado en el servidor; si el canal muestra imágenes va como imagen y si no,
# como enlace temporal firmado en IDENTITY_PUBLIC_BASE_URL/media/graficos/...
# Para activarlo: CLIENT_DATA_ENABLED=true, IDENTITY_PUBLIC_BASE_URL https y una
# CHART_LINK_SIGNING_KEY aleatoria de 32+ caracteres distinta de IDENTITY_LINK_SIGNING_KEY
# (por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))").
CHARTS_ENABLED=false
CHART_LINK_SIGNING_KEY=
CHART_LINK_TTL_SECONDS=3600
CHART_TRIGGER_PHRASES=grafica,grafico,graficar,graficame,diagrama
CHART_LINK_LABEL=Ver gráfico
CHART_DISABLED_REPLY=Los gráficos no están disponibles por ahora.
CHART_NO_DATA_REPLY=No encontré datos para graficar con esa pregunta. Prueba con otro periodo o pregúntalo de otra forma.

# memoria por cliente (#40, #57)
# Activada por decisión del dueño (2026-11-14); la memoria dura hasta la supresión.
MEMORY_ENABLED=true
MEMORY_MAX_ITEMS=20
MEMORY_ITEM_MAX_CHARS=300
MEMORY_SUMMARY_MAX_CHARS=1500
MEMORY_INPUT_MAX_MESSAGES=200
MEMORY_CONTEXT_MESSAGES=20
MEMORY_PANEL_SUMMARIES=5
MEMORY_SENSITIVE_MIN_DIGITS=6
MEMORY_SENSITIVE_KEYWORDS=contraseña,contrasena,password,clave,pin,token,codigo de verificacion,cvv,tarjeta,cuenta bancaria,cedula,pasaporte,diagnostico,enfermedad,salud,medicamento,embarazo,discapacidad,religion,orientacion sexual,vida sexual,partido politico,afiliacion politica,sindicato,origen etnico,raza,biometric,huella
# memoria por contacto sin login (fase 3): hechos (nombre, empresa, producto de
# interés, pedido/caso, preferencia de contacto) que el LLM extrae cada N mensajes
# del contacto o antes si el mensaje trae una frase de dato nuevo.
MEMORY_FACTS_EVERY_MESSAGES=5
MEMORY_FACTS_INPUT_MESSAGES=20
MEMORY_FACT_MAX_CHARS=120
MEMORY_FACT_TRIGGER_PHRASES=me llamo,mi nombre es,soy de la empresa,trabajo en,trabajo para,mi empresa,me interesa,estoy interesado,estoy interesada,quiero el plan,quiero contratar,quiero comprar,mi pedido,mi caso,numero de caso,mi ticket,prefiero que,llamame,escribeme,contactame
# preguntas sobre lo dicho antes ("¿qué plan te dije?"): se responden con esa memoria
MEMORY_RECALL_PHRASES=te dije,te comente,te conte,te mencione,te habia dicho,recuerdas mi,te acuerdas de mi,como me llamo,cual es mi nombre,sabes mi nombre,sabes quien soy,que sabes de mi
# roles que pueden ejecutar la supresión por persona (admin, asesor y/o responsable_datos)
SUPPRESSION_EXECUTOR_ROLES=admin

# panel de asesores multicanal (#41)
# regla de proveedor de WhatsApp: ventana de texto libre en horas (1-24)
WHATSAPP_WINDOW_HOURS=24
# Segundos que el orquestador reutiliza la lista de canales del gateway (1-3600).
CHANNEL_DIRECTORY_TTL_SECONDS=30
# Base pública https del gateway; el panel /admin/canales muestra <base>/webhooks/<canal_id>.
GATEWAY_PUBLIC_BASE_URL=
# CSV no vacía de nombres ^[a-z0-9_]{1,64}$ que el asesor puede enviar como plantilla
ADVISOR_WHATSAPP_TEMPLATES=respuesta_asesor
ADVISOR_RETURN_REPLY=Te devolvemos al asistente virtual. Puedes seguir escribiendo aquí.
ADVISOR_HISTORY_LOOKBACK_MINUTES=60
ADVISOR_HISTORY_MAX_MESSAGES=100
ADVISOR_PRESENCE_TTL_MINUTES=15
ADVISOR_INBOX_REFRESH_SECONDS=30
# bandeja unificada de conversaciones (#68)
# true: asesores y supervisores ven también las conversaciones atendidas por el bot
PANEL_BOT_CONVERSATIONS_VISIBLE=true
# máximo de conversaciones listadas en la bandeja (1-1000)
PANEL_CONVERSATIONS_LIMIT=200
# intención de compra (#70): frases iniciales y ajustes; el panel los sobrescribe
PURCHASE_INTENT_ENABLED=true
# lista separada por comas: 1-30 frases de 3-80 caracteres normalizados
PURCHASE_INTENT_PHRASES=me interesa,quiero reservar,quiero comprar
# minutos mínimos entre avisos de la misma conversación (1-1440)
PURCHASE_INTENT_INTERVAL_MINUTES=60
# true: abre un caso automáticamente tras responder (por defecto, no)
PURCHASE_INTENT_CREATE_CASE=false
# horas que la bandeja mantiene la marca de interés (1-720)
PURCHASE_INTENT_MARK_HOURS=72
# panel de asesores en tiempo real (#53)
# interruptor general del websocket de avisos y del JavaScript del panel
PANEL_LIVE_ENABLED=true
# CSV de orígenes exactos permitidos para el websocket; vacío = mismo Host (S1)
PANEL_WS_ALLOWED_ORIGINS=
# intervalo de sondeo de la tabla panel_events (segundos, 1-30)
PANEL_EVENTS_POLL_SECONDS=2
# retención de panel_events (horas, 1-168)
PANEL_EVENTS_RETENTION_HOURS=24
# máximo de conexiones websocket abiertas por perfil en una instancia (1-20)
PANEL_WS_MAX_CONNECTIONS_PER_PROFILE=5
SUPPRESSION_DEADLINE_BUSINESS_DAYS=15
SUPPRESSION_DUE_SOON_BUSINESS_DAYS=3
SUPPRESSION_QUEUE_EXECUTED_LIMIT=20
SUPPRESSION_DONE_REPLY=Tu solicitud de supresión de datos fue atendida.
SUPPRESSION_RESULT_TEMPLATE=resultado_supresion

# notas internas y etiquetas del panel (#50)
CASE_NOTE_MAX_CHARS=1000
CASE_NOTES_MAX_PER_CASE=50
CASE_TAG_NAME_MAX_CHARS=40
CASE_TAGS_MAX_PER_CASE=10

# respuestas guardadas del panel (#51)
SAVED_REPLY_TITLE_MAX_CHARS=80
SAVED_REPLY_TEXT_MAX_CHARS=1000
SAVED_REPLIES_MAX=100

# respuestas rápidas del bot (#71)
# tamaño máximo de la imagen subida (bytes; 1024..5242880)
QUICK_REPLY_IMAGE_MAX_BYTES=2097152

# cola de entrada y outbox en Postgres (#64)
# intentos máximos del worker de entrada (entero >= 1)
INBOX_MAX_ATTEMPTS=3
# espera base del backoff del worker de entrada (segundos > 0)
INBOX_BACKOFF_BASE_SECONDS=5
# intentos máximos de entrega del worker de salida (entero >= 1)
OUTBOX_MAX_ATTEMPTS=6
# espera base del backoff exponencial de salida (segundos > 0)
OUTBOX_BACKOFF_BASE_SECONDS=2
# tope del backoff de entrada y salida (segundos > 0)
OUTBOX_BACKOFF_MAX_SECONDS=300
# jitter del backoff de salida, entre 0 y 1
OUTBOX_BACKOFF_JITTER=0.2
# pausa del bucle del worker cuando no hay filas (segundos > 0)
WORKER_POLL_SECONDS=1
# concesión de un mensaje reclamado; debe superar el timeout del gateway de 10 s
WORKER_LEASE_SECONDS=120

# WhatsApp Cloud API (#43) — proveedor de producción: Meta
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_INTERACTIVE_BODY_TEXT=Elige una opción:

# Facebook Messenger e Instagram Messaging (fase 7; Instagram requiere cuenta profesional
# vinculada a META_PAGE_ID y permisos/revisión de Meta para usuarios reales).
# Webhook (GET de verificación + POST firmado): <gateway>/webhooks/messenger.
# META_PAGE_ACCESS_TOKEN solo siembra o rota el token: se guarda cifrado con
# CHANNEL_SECRETS_KEY (obligatoria) en `canales` y puede quitarse tras el primer arranque.
META_MESSENGER_ENABLED=false
META_INSTAGRAM_ENABLED=false
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v26.0
META_MESSAGING_WINDOW_HOURS=24

# TikTok Business Messaging (fase 6), webhook: <gateway>/webhooks/tiktok.
# Requiere acceso aprobado a Business Messaging y autorización de la cuenta de TikTok.
# `TIKTOK_CLIENT_KEY`/`TIKTOK_CLIENT_SECRET` identifican la app (refresco OAuth).
# `TIKTOK_WEBHOOK_SECRET` verifica la cabecera TikTok-Signature; vacío = 401 a todo.
# PENDIENTE: confirmar con la doc oficial qué secreto firma (se asume el client_secret).
# Los refresh tokens rotados se guardan cifrados (CHANNEL_SECRETS_KEY) en `canales`;
# Redis aplica el límite de 10 mensajes/48 h.
# TIKTOK_REFRESH_TOKEN es la carga inicial.
TIKTOK_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_WEBHOOK_SECRET=
# `open_id` de la cuenta obtenido en la autorización de TikTok.
TIKTOK_BUSINESS_ID=
TIKTOK_REFRESH_TOKEN=
TIKTOK_TOKEN_URL=https://business-api.tiktok.com/open_api/v1.3/tt_user/oauth2/refresh_token/
TIKTOK_SEND_URL=https://business-api.tiktok.com/open_api/v1.3/business/message/send/
TIKTOK_TOKEN_REFRESH_MARGIN_SECONDS=300
TIKTOK_SIGNATURE_TOLERANCE_SECONDS=300

# administración y avisos (#42)
# los cinco BUSINESS_HOURS_* son solo el valor por defecto; el panel los sobrescribe
BUSINESS_HOURS_ENABLED=false
BUSINESS_HOURS_START=06:00
BUSINESS_HOURS_END=21:00
BUSINESS_HOURS_DAYS=1,2,3,4,5,6,7
BUSINESS_HOURS_UTC_OFFSET_MINUTES=-300
# asignación de casos (#52): manual (por defecto) | automatica; el panel la sobrescribe
ASSIGNMENT_MODE=manual
# estrategia de asignación automática (#69): por_carga | round_robin; el panel la sobrescribe
ASSIGNMENT_STRATEGY=por_carga
EXPIRY_NOTICE_ENABLED=true
EXPIRY_NOTICE_MAX_ATTEMPTS=3
ADMIN_TEXT_HISTORY_LIMIT=20
ADMIN_METRICS_UNANSWERED_LIMIT=20
# expiry_notice_worker
EXPIRY_NOTICE_INTERVAL_SECONDS=3600
EXPIRY_NOTICE_HTTP_TIMEOUT_SECONDS=120

# handover
HANDOVER_TIMEOUT_REPLY=Todavía no hay un asesor disponible. Tu consulta sigue registrada y te responderemos en cuanto sea posible.
# máximo de casos que GET /cases devuelve a un asesor (entero 1–200)
CASE_LIST_LIMIT=50

# timeouts_worker
CHECK_TIMEOUTS_INTERVAL_SECONDS=60
CHECK_TIMEOUTS_HTTP_TIMEOUT_SECONDS=120

# gmail_sync_worker: segundos entre sincronizaciones de los canales Gmail activos
GMAIL_SYNC_INTERVAL_SECONDS=60

# privacidad (#27) — valores APROBADOS POR EL DUEÑO (2026-11-14)
# Sin estos valores el bot no procesa mensajes de clientes y la purga responde 503.
PRIVACY_NOTICE_TEXT=Lázaro Software es responsable de tus datos personales. Los usamos para atender tu consulta y, si lo necesitas, pasarte con un asesor. Conservamos tus mensajes 30 días y, hasta que pidas su supresión, la memoria de temas pendientes y acuerdos. Puedes pedir esa supresión o ejercer tus derechos por este mismo chat. Para continuar, responde ACEPTO.
PRIVACY_NOTICE_VERSION=1.0
PRIVACY_ACCEPT_PHRASE=ACEPTO
# frase de rechazo efectiva en Telegram; vacía = "NO ACEPTO"
PRIVACY_REJECT_PHRASE=NO ACEPTO
# instrucción de consentimiento por texto en Telegram (debe contener {accept} y {reject})
PRIVACY_TEXT_CONSENT_INSTRUCTION=Para aceptar, escribe exactamente: {accept}. Si no aceptas, escribe exactamente: {reject}.
PRIVACY_ACCEPTED_REPLY=Gracias, registramos tu aceptación. ¿En qué te ayudo?
PRIVACY_RETENTION_DAYS=30
# #72: plazo opcional de la aceptación por cliente; vacío = hasta la supresión
CLIENT_CONSENT_RETENTION_DAYS=
# textos fijos del flujo (#37); el panel admin los puede sobrescribir en app_settings
CONVERSATION_GREETING=Hola. Antes de continuar necesitamos tu consentimiento para tratar tus datos.
CONVERSATION_REJECTED_REPLY=Entendido. No trataremos tus datos. Si quieres empezar de nuevo, escríbenos.
CONVERSATION_LOGIN_REMINDER=Para continuar, inicia sesión con el enlace que te enviamos desde el chat.
CONVERSATION_SUSPENDED_REPLY=El servicio está suspendido por falta de pago. Puedes hablar con un asesor o pedir que borren tus datos.
CONVERSATION_UNSUPPORTED_REPLY=Por ahora solo puedo leer mensajes de texto.
CONVERSATION_ACTIVE_WELCOME=Bienvenido. Puedes preguntarme sobre los temas disponibles.
CONVERSATION_CONFIRM_BUTTON_REPLY=Para aceptar el tratamiento de tus datos, pulsa el botón Acepto.
# #73: mensaje introductorio antes del ID de cliente y de la lista de canales
CONVERSATION_CLIENT_ID_INTRO=Este es tu ID de cliente. Guárdalo para soporte; no identifica a nadie si lo escribes en el chat.
CONVERSATION_CHANNELS_INTRO=También puedes escribirnos por estos canales:
# #73: los canales simulados no aparecen en la bienvenida salvo demostración explícita
CHANNELS_WELCOME_INCLUDE_SIMULATED=false
# identidad y credenciales de clientes (#38)
# URL pública del orchestrator; en producción debe empezar por https://
IDENTITY_PUBLIC_BASE_URL=
# secreto de firma de los enlaces de login; >= 32 caracteres en producción
IDENTITY_LINK_SIGNING_KEY=
# false solo en desarrollo/tests; en producción debe ser true
IDENTITY_LOGIN_REQUIRED=true
IDENTITY_LINK_TTL_MINUTES=15
IDENTITY_SESSION_IDLE_MINUTES=60
IDENTITY_LOGIN_MAX_ATTEMPTS=5
IDENTITY_LOCKOUT_MINUTES=15
CREDENTIAL_VALIDITY_DAYS=30
CREDENTIAL_EXPIRY_NOTICE_DAYS=5
IDENTITY_LOGOUT_COMMANDS=/salir,cerrar sesion,cerrar sesión
IDENTITY_CLIENT_ID_COMMANDS=/id,mi id,mi id de cliente
# potencia de 2 >= 16384; r=8, p=1
PASSWORD_SCRYPT_N=32768
# debe ser menor que PRIVACY_RETENTION_DAYS
PRIVACY_ACTIVE_CASE_MAX_DAYS=15
# retention_worker (mecanismo; los plazos aprobados son las dos variables de arriba)
PRIVACY_PURGE_INTERVAL_SECONDS=86400
PRIVACY_PURGE_HTTP_TIMEOUT_SECONDS=120

# rag
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIM=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# búsqueda híbrida (#31): apagada hasta comparar la evaluación semántica e híbrida
RAG_HYBRID_ENABLED=false
RAG_HYBRID_CANDIDATE_LIMIT=50

# telegram_gateway
# webhook genérico firmado (#62)
# ventana anti-repetición de X-Lazaro-Timestamp (segundos, 1-3600)
WEBHOOK_SIGNATURE_WINDOW_SECONDS=300
# tamaño máximo del cuerpo del webhook (bytes, 1024-10485760)
WEBHOOK_MAX_BODY_BYTES=1048576
# SOLO desarrollo/tests: permite callbacks http y hacia direcciones privadas.
# Riesgo SSRF: en producción (APP_ENV=production) el servicio no arranca con true.
WEBHOOK_ALLOW_PRIVATE_CALLBACKS=false
# buzón del canal SIMULADO (#63): solo pruebas, nunca datos personales reales
# retención por entrada en segundos (60-86400)
SIMULATED_MAILBOX_RETENTION_SECONDS=3600
# máximo de entradas por canal (10-5000)
SIMULATED_MAILBOX_MAX_ENTRIES=500
CHANNEL_SECRETS_KEY=
# Clave Fernet para secretos de canales: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEDUP_TTL_SECONDS=86400
HTTP_TIMEOUT_SECONDS=10
# Cola de reintento hacia el orquestador (fase 2): si el orquestador no responde,
# el mensaje se guarda en Postgres y se reenvía con espera creciente
# (base · 2^intentos, con tope). Pasada la antigüedad máxima se descarta con log.
INBOUND_RETRY_BASE_SECONDS=2.0
INBOUND_RETRY_MAX_DELAY_SECONDS=300
INBOUND_RETRY_MAX_AGE_SECONDS=172800
INBOUND_RETRY_POLL_SECONDS=1.0
INBOUND_RETRY_LEASE_SECONDS=60
INBOUND_RETRY_BATCH_SIZE=50
# agrupación de mensajes consecutivos (#30)
MESSAGE_GROUPING_ENABLED=true
MESSAGE_GROUPING_WINDOW_SECONDS=2.0
MESSAGE_GROUPING_MAX_WAIT_SECONDS=8.0
MESSAGE_GROUPING_MAX_MESSAGES=10
MESSAGE_GROUPING_BUFFER_TTL_SECONDS=300
MESSAGE_GROUPING_LEASE_SECONDS=30
MESSAGE_GROUPING_MAX_ATTEMPTS=3
MESSAGE_GROUPING_POLL_SECONDS=0.5
# en Render se hereda de PRIVACY_ACCEPT_PHRASE del orchestrator (fromService/envVarKey)
MESSAGE_GROUPING_ACCEPT_PHRASE=
# en Render se hereda de PRIVACY_REJECT_PHRASE del orchestrator (fromService/envVarKey)
MESSAGE_GROUPING_REJECT_PHRASE=

# eval
EVAL_SINK_PORT=8099

# ── Migraciones (servicio `migrate` de docker compose) ──────────────────────
# El runner aplica migrations/*.sql una vez por despliegue con DATABASE_URL.
# MIGRATIONS_DATABASE_URL lo sustituye si las migraciones deben correr con otro
# usuario (p. ej. uno con permiso para crear roles).
MIGRATIONS_DATABASE_URL=
# Dimensión de los embeddings para la tabla chunks (solo se usa al crearla).
EMBEDDINGS_DIM=1536
