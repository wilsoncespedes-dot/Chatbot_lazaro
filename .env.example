# Copia este archivo como .env y rellena los valores. NUNCA subas .env a git.
# Los agentes tienen prohibido leer .env; solo pueden leer este .env.example.

# Entorno: development | production (en producción se validan los secretos)
APP_ENV=development
# URL pública del servicio telegram_gateway para registrar el webhook
PUBLIC_BASE_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Token compartido entre servicios (encabezado X-Service-Token)
SERVICE_TOKEN=cambia-esto

# Infraestructura
DATABASE_URL=postgresql://lazaro:lazaro@postgres:5432/lazaro
REDIS_URL=redis://redis:6379/0

# Postgres (contenedor)
POSTGRES_USER=lazaro
POSTGRES_PASSWORD=lazaro
POSTGRES_DB=lazaro

# Proveedor de IA (modelos baratos en pruebas)
LLM_API_KEY=
LLM_MODEL=
EMBEDDINGS_MODEL=

# URLs internas
ORCHESTRATOR_URL=http://orchestrator:8000
TELEGRAM_GATEWAY_URL=http://telegram_gateway:8000
RAG_URL=http://rag:8000
HANDOVER_URL=http://handover:8000

# Supuestos a confirmar (ver docs/proyecto.md §12)
RAG_SIMILARITY_THRESHOLD=0.75
RAG_TOP_K=5
HANDOVER_TIMEOUT_SECONDS=300
# enteros separados por comas, sin repetir; negativos para grupos o canales; si hay un valor no válido o repetido, handover no arranca
ADVISOR_CHAT_IDS=

# orchestrator
LLM_BASE_URL=https://api.openai.com/v1
NO_ANSWER_REPLY=No encontré información sobre eso en los manuales. Te paso con un asesor.
HANDOVER_ACK_REPLY=Avisé a un asesor; te responderá por aquí en cuanto pueda.
ERROR_REPLY=Tuve un problema para responderte. Inténtalo de nuevo en unos minutos.
INVALID_ANSWER_HANDOVER=true
# traspaso automático (#32): fallos consecutivos antes de derivar y motivos que cuentan
# AUTO_HANDOVER_FAILURE_REASONS solo admite no_relevant_chunks e invalid_answer
AUTO_HANDOVER_FAILURE_THRESHOLD=3
AUTO_HANDOVER_FAILURE_REASONS=no_relevant_chunks,invalid_answer
HANDOVER_KEYWORDS=hablar con una persona,hablar con un asesor,hablar con un humano,quiero un asesor,quiero un agente,agente humano
NO_ADVISORS_REPLY=En este momento no hay asesores disponibles. Tu consulta quedó registrada y te escribiremos en cuanto haya alguien.
ADVISOR_REPLY_CONFIRMATION=Respuesta enviada al cliente.
ADVISOR_CLOSE_CONFIRMATION=Caso cerrado.
CASE_CLOSED_REPLY=Tu caso con el asesor quedó cerrado. Si necesitas algo más, escríbenos por aquí.
FORWARD_FAILED_REPLY=No pude hacer llegar tu mensaje al asesor. Inténtalo de nuevo en unos minutos.
ADVISOR_COMMAND_HELP=Comandos de asesor: /responder <case_id> <texto> para responder al cliente y /cerrar <case_id> para cerrar el caso.
ADVISOR_COMMAND_FORBIDDEN_REPLY=No tienes permiso para usar ese comando sobre ese caso.
ADVISOR_COMMAND_FAILED_REPLY=No se pudo completar el comando. Revisa el número de caso o inténtalo de nuevo en unos minutos.
ADVISOR_COMMAND_CASE_CLOSED_REPLY=Ese caso ya está cerrado.
# verificación de cuentas (#20)
LINK_TOKEN_TTL_MINUTES=15
PASSWORD_HASH_ITERATIONS=600000
PROFILE_PASSWORD_MIN_LENGTH=12
TELEGRAM_BOT_USERNAME=
LINK_SUCCESS_REPLY=Tu cuenta de Telegram quedó vinculada a tu perfil.
LINK_FAILED_REPLY=No se pudo vincular la cuenta. Pide un enlace nuevo a tu administrador.
# panel administrativo (#21)
ADMIN_SESSION_TTL_MINUTES=60
ADMIN_COOKIE_SECURE=true
ADMIN_EVENTS_LIMIT=100
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_TRUST_PROXY_HEADERS=false
# límite de tamaño de la carga de manuales desde el panel (#22)
ADMIN_MANUAL_MAX_BYTES=20971520
# clasificador de consultas (#25): umbral por defecto entre 0 y 1
CLASSIFIER_DEFAULT_THRESHOLD=0.6
# consultas de datos en lenguaje natural (#26)
# Supuesto S1: al activar DB_QUERY_ENABLED se envían al proveedor de IA SOLO los
# nombres estáticos de las vistas y columnas de DB_QUERY_ALLOWLIST; nunca filas.
DB_QUERY_ENABLED=false
# DSN de solo lectura, distinto de DATABASE_URL; el dueño crea el rol (docs/consulta_bd.md)
DB_QUERY_DATABASE_URL=
DB_QUERY_VIEWS_SCHEMA=consultas
# JSON {"consultas.v_pedidos": ["id", "estado"], ...}
DB_QUERY_ALLOWLIST=
DB_QUERY_MAX_ROWS=50
DB_QUERY_TIMEOUT_MS=5000
DB_QUERY_MAX_JOINS=1
DB_QUERY_MAX_QUESTION_LENGTH=500
DB_QUERY_MAX_REPLY_CHARS=3500
DB_QUERY_HELP_REPLY=Uso: /consultar <pregunta>. Ejemplo: /consultar cuántos pedidos hay pendientes.
DB_QUERY_FORBIDDEN_REPLY=No tienes permiso para consultar datos. Esta función es solo para asesores verificados.
DB_QUERY_DISABLED_REPLY=Las consultas de datos están deshabilitadas en este momento.
DB_QUERY_REJECTED_REPLY=No pude construir una consulta segura para esa pregunta. Reformúlala o consulta una vista permitida.
DB_QUERY_UNAVAILABLE_REPLY=No se pudo completar la consulta de datos. Inténtalo de nuevo más tarde.
DB_QUERY_TRUNCATED_NOTE=Mostrando solo las primeras filas; hay más resultados.

# harness de IA por estado (#39)
HARNESS_ROUTER_ENABLED=false
HARNESS_MAX_INPUT_CHARS=2000
HARNESS_INJECTION_PATTERNS=ignora tus instrucciones,ignora tus reglas,ignora las instrucciones,olvida tus reglas,ignore previous instructions,system prompt,prompt de sistema,actua como administrador,modo desarrollador,jailbreak
HARNESS_FRUSTRATION_ESCALATION=true
HARNESS_FRUSTRATION_KEYWORDS=no me sirves,no me estas ayudando,esto no sirve,estoy harto,estoy harta,pesimo servicio,que mal servicio
HARNESS_SUPPRESSION_KEYWORDS=borrar mis datos,borren mis datos,suprimir mis datos,eliminar mis datos,eliminen mis datos
HARNESS_INPUT_TOO_LONG_REPLY=Tu mensaje es muy largo. Escríbelo en un mensaje más corto, por favor.
HARNESS_TOOL_DENIED_REPLY=No puedo hacer eso en este momento. Si necesitas ayuda, puedo pasarte con un asesor.
SUPPRESSION_REQUEST_REPLY=Registramos tu solicitud de supresión de datos con el número {request_id}. Una persona autorizada la atenderá y te informará el resultado.
# datos propios del cliente (#39): vistas con RLS y rol separado, ver docs/consulta_bd.md
CLIENT_DATA_ENABLED=false
CLIENT_DATA_DATABASE_URL=
CLIENT_DATA_VIEWS_SCHEMA=mis_datos
CLIENT_DATA_ALLOWLIST=
CLIENT_DATA_RLS_SETTING=lazaro.cliente_id
CLIENT_DATA_MAX_ROWS=20
CLIENT_DATA_TIMEOUT_MS=5000
CLIENT_DATA_MAX_JOINS=1
CLIENT_DATA_MAX_REPLY_CHARS=3500
CLIENT_DATA_TRUNCATED_NOTE=Mostrando solo las primeras filas; hay más resultados.
CLIENT_DATA_DISABLED_REPLY=La consulta de tus datos no está disponible por ahora.
CLIENT_DATA_REJECTED_REPLY=No pude construir una consulta segura para esa pregunta. Intenta formularla de otra forma.
CLIENT_DATA_UNAVAILABLE_REPLY=No se pudo consultar tus datos. Inténtalo de nuevo más tarde.

# memoria por cliente (#40)
# Apagada hasta que el área legal valide la justificación y el plazo (#40 S1).
MEMORY_ENABLED=false
MEMORY_MAX_ITEMS=20
MEMORY_ITEM_MAX_CHARS=300
MEMORY_SUMMARY_MAX_CHARS=1500
MEMORY_INPUT_MAX_MESSAGES=200
MEMORY_CONTEXT_MESSAGES=6
MEMORY_PANEL_SUMMARIES=5
MEMORY_SENSITIVE_MIN_DIGITS=6
MEMORY_SENSITIVE_KEYWORDS=contraseña,contrasena,password,clave,pin,token,codigo de verificacion,cvv,tarjeta,cuenta bancaria,cedula,pasaporte,diagnostico,enfermedad,salud,medicamento,embarazo,discapacidad,religion,orientacion sexual,vida sexual,partido politico,afiliacion politica,sindicato,origen etnico,raza,biometric,huella
# roles que pueden ejecutar la supresión por persona (admin y/o asesor)
SUPPRESSION_EXECUTOR_ROLES=admin

# panel de asesores multicanal (#41)
# regla de proveedor de WhatsApp: ventana de texto libre en horas (1-24)
WHATSAPP_WINDOW_HOURS=24
# CSV no vacía de nombres ^[a-z0-9_]{1,64}$ que el asesor puede enviar como plantilla
ADVISOR_WHATSAPP_TEMPLATES=respuesta_asesor
ADVISOR_RETURN_REPLY=Te devolvemos al asistente virtual. Puedes seguir escribiendo aquí.
ADVISOR_HISTORY_LOOKBACK_MINUTES=60
ADVISOR_HISTORY_MAX_MESSAGES=100
ADVISOR_PRESENCE_TTL_MINUTES=15
ADVISOR_INBOX_REFRESH_SECONDS=30
SUPPRESSION_DEADLINE_BUSINESS_DAYS=15
SUPPRESSION_DUE_SOON_BUSINESS_DAYS=3
SUPPRESSION_QUEUE_EXECUTED_LIMIT=20
SUPPRESSION_DONE_REPLY=Tu solicitud de supresión de datos fue atendida.
SUPPRESSION_RESULT_TEMPLATE=resultado_supresion

# WhatsApp Cloud API (#43) — proveedor de producción: Meta
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_INTERACTIVE_BODY_TEXT=Elige una opción:

# administración y avisos (#42)
# los cinco BUSINESS_HOURS_* son solo el valor por defecto; el panel los sobrescribe
BUSINESS_HOURS_ENABLED=false
BUSINESS_HOURS_START=06:00
BUSINESS_HOURS_END=21:00
BUSINESS_HOURS_DAYS=1,2,3,4,5,6,7
BUSINESS_HOURS_UTC_OFFSET_MINUTES=-300
EXPIRY_NOTICE_ENABLED=true
EXPIRY_NOTICE_MAX_ATTEMPTS=3
ADMIN_TEXT_HISTORY_LIMIT=20
ADMIN_METRICS_UNANSWERED_LIMIT=20
# expiry_notice_worker
EXPIRY_NOTICE_INTERVAL_SECONDS=3600
EXPIRY_NOTICE_HTTP_TIMEOUT_SECONDS=120

# handover
HANDOVER_TIMEOUT_REPLY=Todavía no hay un asesor disponible. Tu consulta sigue registrada y te responderemos en cuanto sea posible.
# máximo de casos que GET /cases devuelve a un asesor (entero 1–200)
CASE_LIST_LIMIT=50

# timeouts_worker
CHECK_TIMEOUTS_INTERVAL_SECONDS=60
CHECK_TIMEOUTS_HTTP_TIMEOUT_SECONDS=120

# privacidad (#27) — valores APROBADOS POR EL DUEÑO
# Sin estos valores el bot no procesa mensajes de clientes y la purga responde 503.
PRIVACY_NOTICE_TEXT=
PRIVACY_NOTICE_VERSION=
PRIVACY_ACCEPT_PHRASE=
PRIVACY_ACCEPTED_REPLY=
PRIVACY_RETENTION_DAYS=
# textos fijos del flujo (#37); el panel admin los puede sobrescribir en app_settings
CONVERSATION_GREETING=Hola. Antes de continuar necesitamos tu consentimiento para tratar tus datos.
CONVERSATION_REJECTED_REPLY=Entendido. No trataremos tus datos. Si quieres empezar de nuevo, escríbenos.
CONVERSATION_LOGIN_REMINDER=Para continuar, inicia sesión con el enlace que te enviamos desde el chat.
CONVERSATION_SUSPENDED_REPLY=El servicio está suspendido por falta de pago. Puedes hablar con un asesor o pedir que borren tus datos.
CONVERSATION_UNSUPPORTED_REPLY=Por ahora solo puedo leer mensajes de texto.
CONVERSATION_ACTIVE_WELCOME=Bienvenido. Puedes preguntarme sobre los temas disponibles.
CONVERSATION_CONFIRM_BUTTON_REPLY=Para aceptar el tratamiento de tus datos, pulsa el botón Acepto.
# identidad y credenciales de clientes (#38)
# URL pública del orchestrator; en producción debe empezar por https://
IDENTITY_PUBLIC_BASE_URL=
# secreto de firma de los enlaces de login; >= 32 caracteres en producción
IDENTITY_LINK_SIGNING_KEY=
# false solo en desarrollo/tests; en producción debe ser true
IDENTITY_LOGIN_REQUIRED=true
IDENTITY_LINK_TTL_MINUTES=15
IDENTITY_SESSION_IDLE_MINUTES=60
IDENTITY_LOGIN_MAX_ATTEMPTS=5
IDENTITY_LOCKOUT_MINUTES=15
CREDENTIAL_VALIDITY_DAYS=30
CREDENTIAL_EXPIRY_NOTICE_DAYS=5
IDENTITY_LOGOUT_COMMANDS=/salir,cerrar sesion,cerrar sesión
# potencia de 2 >= 16384; r=8, p=1
PASSWORD_SCRYPT_N=32768
# debe ser menor que PRIVACY_RETENTION_DAYS
PRIVACY_ACTIVE_CASE_MAX_DAYS=
# retention_worker (mecanismo; los plazos aprobados son las dos variables de arriba)
PRIVACY_PURGE_INTERVAL_SECONDS=86400
PRIVACY_PURGE_HTTP_TIMEOUT_SECONDS=120

# rag
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIM=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# búsqueda híbrida (#31): apagada hasta comparar la evaluación semántica e híbrida
RAG_HYBRID_ENABLED=false
RAG_HYBRID_CANDIDATE_LIMIT=50

# telegram_gateway
DEDUP_TTL_SECONDS=86400
HTTP_TIMEOUT_SECONDS=10
NON_TEXT_REPLY=Por ahora solo puedo leer mensajes de texto.
# agrupación de mensajes consecutivos (#30)
MESSAGE_GROUPING_ENABLED=true
MESSAGE_GROUPING_WINDOW_SECONDS=2.0
MESSAGE_GROUPING_MAX_WAIT_SECONDS=8.0
MESSAGE_GROUPING_MAX_MESSAGES=10
MESSAGE_GROUPING_BUFFER_TTL_SECONDS=300
MESSAGE_GROUPING_LEASE_SECONDS=30
MESSAGE_GROUPING_MAX_ATTEMPTS=3
MESSAGE_GROUPING_POLL_SECONDS=0.5
# en Render se hereda de PRIVACY_ACCEPT_PHRASE del orchestrator (fromService/envVarKey)
MESSAGE_GROUPING_ACCEPT_PHRASE=

# eval
EVAL_SINK_PORT=8099
